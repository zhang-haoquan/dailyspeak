# 依赖
node_modules/

# 构建产物
dist/
*.tsbuildinfo
coverage/

# Prisma 生成的客户端（由 prisma generate 重新生成，不入库）
apps/api/src/generated/

# Supabase CLI 本地临时状态（config.toml 与 migrations 需要入库）
supabase/.temp/
supabase/.branches/

# 本地验证产物（tools/shots.mjs 生成）
shots/
e2e.log

# 编辑器 / 系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# 本地环境变量
.env
.env.local
.env.*.local

# 日志
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
