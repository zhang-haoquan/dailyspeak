{
  "name": "dailyspeak",
  "private": true,
  "version": "0.1.0",
  "description": "DailySpeak — 场景化英语求职口语陪练",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:shared": "npm run build -w @dailyspeak/shared",
    "dev": "npm run dev:web",
    "dev:web": "npm run build:shared && npm run dev -w @dailyspeak/web",
    "dev:api": "npm run build:shared && npm run start:dev -w @dailyspeak/api",
    "build": "npm run build:shared && npm run build:web && npm run build:api",
    "build:web": "npm run build -w @dailyspeak/web",
    "build:api": "npm run build -w @dailyspeak/api",
    "test": "npm run test -w @dailyspeak/api && npm run test -w @dailyspeak/web",
    "test:api": "npm run test -w @dailyspeak/api",
    "typecheck": "npm run typecheck -w @dailyspeak/shared && npm run typecheck -w @dailyspeak/web",
    "db:up": "supabase start",
    "db:down": "supabase stop",
    "db:status": "supabase status",
    "db:migrate": "npm run prisma:migrate -w @dailyspeak/api",
    "db:seed": "npm run prisma:seed -w @dailyspeak/api",
    "db:studio": "npm run prisma:studio -w @dailyspeak/api",
    "e2e": "node tools/e2e.mjs http://localhost:5173",
    "auth-ui": "node --env-file=apps/api/.env tools/auth-ui.mjs http://localhost:5173",
    "smoke": "node --env-file=apps/api/.env tools/api-smoke.mjs",
    "check:providers": "node --env-file=apps/api/.env tools/providers-check.mjs",
    "score-e2e": "node --env-file=apps/api/.env tools/score-e2e.mjs",
    "learning-e2e": "node --env-file=apps/api/.env tools/learning-e2e.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "typescript": "5.9.3"
  }
}
