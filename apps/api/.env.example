# DailySpeak 后端环境变量模板
# 复制为 apps/api/.env 并填入真实值（.env 已被 .gitignore 排除）
#
# ⚠️ 所有密钥只存在于后端。前端（apps/web）不得持有任何 AI 供应商密钥。

# ---- 数据库 ----
# 本地开发：npm run db:up 后用 npx supabase status 查看
# 上线：Supabase 云端 Dashboard → Settings → Database → Connection string → URI
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=public"

# ---- Supabase ----
SUPABASE_URL="http://127.0.0.1:54321"
# publishable 可以进前端；secret 仅服务端使用，绝不能进前端仓库
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""

# ---- 服务 ----
PORT=3000
# 上线后改成你的服务器域名，多个用逗号分隔
CORS_ORIGINS="http://localhost:5173"

# ============================================================
# AI 供应商
# ============================================================

# ---- LLM：DeepSeek（决策 D-012）----
# 语义评测（应答四维）+ 内容生成
# 控制台：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

# ---- ASR：腾讯云语音识别（决策 D-013）----
# 走「一句话识别」SentenceRecognition（同步返回，≤60s，正好覆盖跟读 3-15s 与应答 30-60s）
# 控制台：https://console.cloud.tencent.com/cam/capi  → 访问密钥 → API 密钥管理
#   SecretId  / SecretKey
# 产品开通：https://console.cloud.tencent.com/asr
ASR_PROVIDER="tencent"
TENCENT_SECRET_ID=""
TENCENT_SECRET_KEY=""
# 地域，就近选择可降低时延：ap-guangzhou / ap-shanghai / ap-beijing
TENCENT_ASR_REGION="ap-guangzhou"
# 引擎模型：16k_en = 英语（本项目内容为英文跟读）
# 其他可选：16k_zh 中文、16k_zh-PY 中英粤
TENCENT_ASR_ENGINE="16k_en"
