# 前端环境变量（Vite 会把 VITE_* 打进产物，所以这里只能放公开信息）
# 复制为 apps/web/.env

# 后端 API 地址
VITE_API_BASE_URL="http://localhost:3000"

# Supabase（publishable key 设计上就是给前端用的；secret key 绝不能放这里）
# 本地：npx supabase status 查看
# 云端：Supabase Dashboard → Settings → API
VITE_SUPABASE_URL="http://127.0.0.1:54321"
VITE_SUPABASE_PUBLISHABLE_KEY=""
